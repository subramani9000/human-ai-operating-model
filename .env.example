# Copy to .env and adjust. Defaults work for local development with SQLite.
DATABASE_URL=sqlite:///./hao_client.db             # simulated client ticketing system
PLATFORM_DATABASE_URL=sqlite:///./hao_platform.db  # our platform
# DATABASE_URL=postgresql+psycopg://hao:hao@localhost:5432/hao

# Mock client ticketing system
MOCK_API_KEY=kaveri-dev-key
WEBHOOK_SECRET=kaveri-webhook-secret
MOCK_FAILURE_RATE=0.0            # e.g. 0.05 → 5% of API calls return 503
MOCK_LATENCY_MS=0                # e.g. 800 → simulate a slow client instance
MOCK_WEBHOOK_DUPLICATE_RATE=0.0  # e.g. 0.1 → 10% of webhooks delivered twice

# Platform
TICKETING_BASE_URL=http://localhost:8001
PLATFORM_PUBLIC_URL=http://localhost:8002

# LLM classifier (Phase 2)
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-haiku-5-5
# Set both to the current per-million-token prices (USD) to track cost per ticket
# LLM_INPUT_PRICE_PER_MTOK=
# LLM_OUTPUT_PRICE_PER_MTOK=
USD_TO_INR=84

# Access control (ADR 0011): dev = no login (local only); proxy = SSO via an identity-aware proxy
AUTH_MODE=dev
AUTH_EMAIL_HEADER=X-Forwarded-Email
AUTH_PROXY_SECRET=
AUTH_ALLOWED_DOMAIN=kaveri.example
ADMIN_EMAILS=["ramesh.iyer@kaveri.example"]

# Webhook hardening
WEBHOOK_SECRET_PREVIOUS=        # set to the old secret while rotating, then clear
WEBHOOK_MAX_AGE_S=300
